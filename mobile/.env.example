EXPO_PUBLIC_API_URL=http://localhost:5000

# Audio recording (Phase 11 Part 11-2)
EXPO_PUBLIC_AUDIO_SAMPLE_RATE=16000
EXPO_PUBLIC_AUDIO_MAX_DURATION=10000
EXPO_PUBLIC_AUDIO_FORMAT=WAV
EXPO_PUBLIC_AUDIO_QUALITY=HIGH

# Legacy aliases (optional — mobile reads EXPO_PUBLIC_* only)
# AUDIO_SAMPLE_RATE=16000
# AUDIO_MAX_DURATION=10000
# AUDIO_FORMAT=WAV
# AUDIO_QUALITY=HIGH

# Android Emulator: use http://10.0.2.2:5000
# iOS Simulator: use http://localhost:5000
# Physical device: use your LAN IP, e.g. http://192.168.1.100:5000
