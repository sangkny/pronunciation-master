{
  "expo": {
    "name": "Pronunciation Master",
    "slug": "pronunciation-master",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "pronunciation-master",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pronunciationmaster.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record your pronunciation for AI analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed"
      },
      "package": "com.pronunciationmaster.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Pronunciation Master to record your pronunciation."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:5000"
    }
  }
}
