# Gemma 4 오디오 (Phase 10 Part 1-D)
GEMMA4_MODEL=google/gemma-4-e4b
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION=30000
WEBGPU_ENABLED=true
VITE_WEBGPU_ENABLED=true

# Native Audio (vLLM input_audio) — Phase 10 Part 1-D Complete
ENABLE_AUDIO=true
AUDIO_PROVIDER=vllm
VLLM_API_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=google/gemma-4-e4b
HF_TOKEN=
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Rate Limiting (Redis) — Phase 10 Part 2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=10000
RATE_LIMIT_IP=1000

# Monitoring (Prometheus + Grafana) — Phase 10 Part 4
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
SENTRY_DSN=
DATADOG_API_KEY=

# LLM 프로바이더
LLM_PROVIDER=lmstudio

# LMStudio (OpenAI 호환)
LMSTUDIO_API_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b

# Ollama (대체)
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=gemma:4b

# API 키 (선택사항)
CLAUDE_API_KEY=
GOOGLE_GEMINI_API_KEY=
COHERE_API_KEY=
HF_API_KEY=

# 서버 설정
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pronunciation_master
DB_USER=dev
DB_PASSWORD=devpass

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# Stripe (test keys)
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# 데이터베이스 (legacy)
DATABASE_URL=postgresql://dev:devpass@postgres:5432/pronunciation_master

# 로깅
LOG_LEVEL=debug
